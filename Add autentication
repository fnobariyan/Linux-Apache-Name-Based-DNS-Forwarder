#Creat db-users file with -c
htpasswd -c /etc/httpd/db-users fatemeh
#Edithing mani config file
vi /etc/httpd/conf.d/dl-mcloud.conf

<VirtualHost 192.168.56.106:80>
        ServerName dl.mcloud.local
        ServerAdmin admin@mcloud.local
        DocumentRoot /var/www/html/dl-mcloud/dl-mcloud-local
              <Directory "/var/www/html/dl-mcloud-local/fatemeh">
               AuthType Basic
               AuthName "Restricted Area"
               AuthUserFile /etc/httpd/db-users
               Require valid-user
</Directory>
        ErrorLog     /var/log/httpd/dl-mcloud-error.log
        CustomLog    /var/log/httpd/dl-mcloud-access.log combined
</VirtualHost>

apachectl -t
systemctl restart httpd

